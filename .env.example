# Every setting the site reads. Enter the real values where the site runs
# (in Gomnee for a site Gomnee hosts), and in .env.local on your computer.
# Never commit them.

# Postgres where the Articles Gomnee publishes are stored. Neon works, and on
# Vercel you can add it from the Marketplace. Without it the site still runs,
# with an empty blog.
DATABASE_URL=

# The key this site issues to Gomnee: at least 32 random characters
# (openssl rand -hex 32). Paste the same value in Gomnee to connect.
GOMNEE_PUBLISHING_TOKEN=

# Optional. Extra HTTPS origins allowed to frame private Article previews,
# besides https://app.gomnee.com. Leave empty unless Gomnee asks.
GOMNEE_PREVIEW_STAGING_ORIGINS=
