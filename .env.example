# Every setting the site reads. Copy this file to .env.local for your own
# computer (Next.js loads it; Git ignores it), and never commit real values.
#
# Gomnee reads this file when you connect the repository. Each line marked
# "# required:core" is a protected value Gomnee asks you for before it
# deploys the site; "# optional:core" lines are never asked for. A line
# without a mark counts as required. The values are stored protected and
# given to the site when it builds and runs, never written to Git.

# Postgres where the Articles Gomnee publishes are stored. Neon works, and on
# Vercel you can add it from the Marketplace.
DATABASE_URL= # required:core

# The key this site issues to Gomnee: at least 32 random characters
# (openssl rand -hex 32). Paste the same value under Integrations, CMS.
GOMNEE_PUBLISHING_TOKEN= # required:core

# Extra HTTPS origins allowed to frame private Article previews, besides
# https://app.gomnee.com. Leave empty unless Gomnee asks.
GOMNEE_PREVIEW_STAGING_ORIGINS= # optional:core
